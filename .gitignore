# Live configuration — never commit
config.php

# Uploaded images — ignore all image files but track directory structure
# /images/** (recursive) rather than /images/* (one level) so processed/ and
# generated/ subdirectory contents are also covered.
/images/**
!/images/.htaccess
!/images/index.htm
!/images/originals/
!/images/originals/.gitkeep
!/images/processed/
!/images/processed/twitter/
!/images/processed/twitter/.gitkeep
!/images/processed/facebook/
!/images/processed/facebook/.gitkeep
!/images/processed/instagram/
!/images/processed/instagram/.gitkeep
!/images/generated/
!/images/generated/twitter/
!/images/generated/twitter/.gitkeep
!/images/generated/facebook/
!/images/generated/facebook/.gitkeep
!/images/generated/instagram/
!/images/generated/instagram/.gitkeep

# Composer dependencies
/vendor/

# Claude Code local project settings
.claude/

# PHPUnit local cache — generated per machine, not project state
.phpunit.result.cache

# Error logs
*.log
PDOErrors.txt
