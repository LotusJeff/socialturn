
# ============================================================
# SocialTurn — Apache configuration
# nginx users: use nginx.conf.sample in the repository root
# instead of this file. See the comment header in that file
# for include instructions.
# ============================================================

DirectoryIndex index.php

# -----------------------------------------------------------------------
# Security: block direct access to configuration files
# -----------------------------------------------------------------------
<FilesMatch "^config(\.sample)?\.php$">
    Require all denied
</FilesMatch>

# -----------------------------------------------------------------------
# Security: block access to composer files and dot-files
# -----------------------------------------------------------------------
<FilesMatch "^(composer\.(json|lock)|\.gitignore|\.gitkeep)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
# Turn on URL rewriting
RewriteEngine On

# Do not enable rewriting for files or directories that exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# For reuests that are not actual files or directories,
# Rewrite to index.php/URL
RewriteRule ^(.*)$ index.php/$1 [PT,L]


</IfModule>