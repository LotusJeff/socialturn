
# ============================================================
# SocialTurn — Apache configuration
# nginx users: use nginx.conf.sample in the repository root
# instead of this file. See the comment header in that file
# for include instructions.
# ============================================================

DirectoryIndex index.php

# -----------------------------------------------------------------------
# Security: block direct access to configuration files
# -----------------------------------------------------------------------
<FilesMatch "^config(\.sample)?\.php$">
    Require all denied
</FilesMatch>

# -----------------------------------------------------------------------
# Security: block access to composer files and dot-files
# -----------------------------------------------------------------------
<FilesMatch "^(composer\.(json|lock)|\.gitignore|\.gitkeep)$">
    Require all denied
</FilesMatch>

# -----------------------------------------------------------------------
# Security: block direct access to config.ini / socialturn.ini
# -----------------------------------------------------------------------
<FilesMatch "\.ini$">
    Require all denied
</FilesMatch>

# -----------------------------------------------------------------------
# Security: block direct access to boot.php (path locator — no credentials
# but reveals the filesystem path to socialturn.ini)
# -----------------------------------------------------------------------
<FilesMatch "^boot\.php$">
    Require all denied
</FilesMatch>

# -----------------------------------------------------------------------
# Security: cron.php is CLI-only — block all HTTP access
# -----------------------------------------------------------------------
<FilesMatch "^cron\.php$">
    Require all denied
</FilesMatch>

