{
    "name": "socialturn/socialturn",
    "description": "Self-hosted social media scheduling and auto-publishing engine",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "abraham/twitteroauth": "^4.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "SocialTurn\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test":             "phpunit --testdox",
        "test:unit":        "phpunit --testsuite Unit --testdox",
        "test:integration": "phpunit --testsuite Integration --testdox",
        "test:platform":    "phpunit --testsuite Platform --testdox"
    },
    "config": {
        "optimize-autoloader": true
    }
}
